{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "openlab-modules/placeholder-text",
    "title": "Placeholder Text",
    "category": "openlab-modules",
    "icon": "menu",
    "description": "Placeholder text for use in the editor.",
    "supports": {
      "inserter": false
    },
    "attributes": {
      "textContent": {
        "type": "string",
        "default": ""
      }
    },
    "textdomain": "openlab-module-builder",
    "editorScript": {
      "handle": "openlab-module-builder-placeholder-text-editor-script",
      "path": "index.js",
      "module": true
    },
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css"
}
